POWER_IMAGE_ADAPTER_HOST=0.0.0.0
POWER_IMAGE_ADAPTER_PORT=8001
POWER_IMAGE_ADAPTER_API_TOKEN=replace-with-a-long-random-token
POWER_IMAGE_ADAPTER_PUBLIC_BASE_URL=http://127.0.0.1:8001
POWER_IMAGE_ADAPTER_DB_URL=sqlite:///D:/data/patrol_images.db
POWER_IMAGE_ADAPTER_IMAGE_QUERY=SELECT image_data AS image_data, mime_type AS mime_type, file_name AS file_name FROM patrol_images WHERE id = :record_id
POWER_IMAGE_ADAPTER_IMAGE_FIELD_ENCODING=binary
POWER_IMAGE_ADAPTER_SIGNING_SECRET=replace-with-a-long-random-secret
POWER_IMAGE_ADAPTER_DEFAULT_URL_TTL_SEC=300
POWER_IMAGE_ADAPTER_MAX_URL_TTL_SEC=3600
POWER_IMAGE_ADAPTER_INSPECTION_API_URL=http://127.0.0.1:8000/api/v1/inspect
POWER_IMAGE_ADAPTER_INSPECTION_API_TOKEN=replace-with-inspection-token
POWER_IMAGE_ADAPTER_REQUEST_TIMEOUT=120
POWER_IMAGE_ADAPTER_LOG_LEVEL=INFO
