POWER_INSPECTION_HOST=127.0.0.1
POWER_INSPECTION_PORT=8000
POWER_INSPECTION_API_TOKEN=replace-with-a-long-random-token
POWER_INSPECTION_AUDIT_LOG_ENABLED=true
POWER_INSPECTION_AUDIT_LOG_DIR=/opt/power-inspection/logs
POWER_INSPECTION_LOG_LEVEL=INFO
POWER_INSPECTION_LOG_MAX_BYTES=20971520
POWER_INSPECTION_LOG_BACKUP_COUNT=5
POWER_INSPECTION_NEST_WEIGHTS=/opt/power-inspection/nest_detection/weights/best.pt
POWER_INSPECTION_TOWER_WEIGHTS=/opt/power-inspection/tower_tilt_detection/runs/detect/tower_detector/weights/best.pt
POWER_INSPECTION_TOWER_THRESHOLDS=/opt/power-inspection/tower_tilt_detection/runs/tilt_calibration/thresholds.json
